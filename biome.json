{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.md", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "core must be deterministic: pass time in as a parameter.",
                  "performance": "core must be deterministic: pass time in as a parameter.",
                  "setTimeout": "core has no side effects: scheduling belongs to the server or clients.",
                  "setInterval": "core has no side effects: scheduling belongs to the server or clients.",
                  "fetch": "core does no IO.",
                  "process": "core does no IO.",
                  "console": "core does no IO."
                }
              }
            }
          }
        }
      }
    }
  ]
}
