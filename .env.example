# Copy to .env next to docker-compose.yml. Never commit .env.
# Public host name, DNS pointing to this machine, ports 80 and 443 open.
EPIDLE_SITE=epidle.example.org
# Entra app registration (see README). Ask the project owner, they are not in the repo.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Only if the redirect URI is on the "Web" platform.
ENTRA_CLIENT_SECRET=
# Seasons start at this date plus whole seasons (ISO date with offset).
# SEASON_START=2026-11-02T18:00:00+01:00
# BACKUP_INTERVAL_HOURS=6
# BACKUP_KEEP=28
