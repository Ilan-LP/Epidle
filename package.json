{
  "name": "epidle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @epidle/server --filter @epidle/web --parallel dev",
    "cli": "pnpm --filter epidle start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "sim": "pnpm --filter @epidle/sim start",
    "admin": "pnpm --filter @epidle/server admin",
    "anticheat": "vitest run apps/server/src/anti-cheat.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
