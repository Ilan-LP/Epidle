{
  "name": "@epidle/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "admin": "tsx --env-file-if-exists=.env src/admin-cli.ts",
    "build": "esbuild server=src/index.ts admin=src/admin-cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --external:better-sqlite3 --external:fastify --external:@fastify/cookie --external:@fastify/rate-limit --external:jose",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@epidle/core": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "esbuild": "^0.28.2"
  }
}
