{
  "name": "epidle",
  "version": "0.2.0",
  "description": "Epidle dans le terminal : monte ta boîte de dev, forme tes juniors, règle tes moulis.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "epidle": "dist/epidle.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.tsx",
    "build": "node build.mjs",
    "prepack": "node build.mjs --publish",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@epidle/api-client": "workspace:*",
    "@epidle/core": "workspace:*",
    "@epidle/ui-theme": "workspace:*",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2"
  }
}
