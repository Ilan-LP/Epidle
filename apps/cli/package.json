{
  "name": "epidle",
  "version": "0.1.0",
  "description": "Epidle dans le terminal : monte ta boîte de dev, forme tes juniors, règle tes moulis.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "epidle": "dist/epidle.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.tsx",
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --target=node22 --jsx=automatic --external:ink --external:react --banner:js=\"#!/usr/bin/env node\" --outfile=dist/epidle.js",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@epidle/api-client": "workspace:*",
    "@epidle/core": "workspace:*",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2"
  }
}
